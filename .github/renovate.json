{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "timezone": "America/Los_Angeles",
  "extends": [
    ":dependencyDashboard",
    ":preserveSemverRanges",
    ":semanticCommits",
    ":semanticCommitTypeAll(renovatebot)",
    "group:monorepos",
    "group:recommended",
    "replacements:all",
    "workarounds:all"
  ],
  "enabledManagers": [
    "gradle",
    "npm",
    "regex",
    "dockerfile",
    "docker-compose",
    "github-actions"
  ],
  "rebaseWhen": "behind-base-branch",
  "automerge": false,
  "regexManagers": [
    {
      "fileMatch": [
        ".*\\.sh"
      ],
      "matchStrings": [
        "export\\s+DOCKER_IMAGE\\s*=\\s*\"(?<depName>[^\"]+):(?<currentValue>[^\"]+)\""
      ],
      "datasourceTemplate": "docker"
    },
    {
      "fileMatch": [
        ".github/workflows/.*\\.yml$"
      ],
      "matchStrings": [
        "NODE_CURRENT:\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "node",
      "depNameTemplate": "node",
      "versioningTemplate": "node"
    },
    {
      "fileMatch": [
        ".github/workflows/.*\\.yml$"
      ],
      "matchStrings": [
        "PYTHON_VERSION:\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "pypi",
      "depNameTemplate": "python",
      "versioningTemplate": "pep440"
    },
    {
      "fileMatch": [
        ".github/workflows/.*\\.yml$"
      ],
      "matchStrings": [
        "RUBY_VERSION:\\s*'(?<currentValue>\\d+\\.\\d+\\.\\d+)'"
      ],
      "datasourceTemplate": "ruby-version",
      "depNameTemplate": "ruby",
      "versioningTemplate": "semver"
    }
  ],
  "labels": [
    "Bot",
    "Renovate"
  ],
  "schedule": [
    "* 0-5 * * 1,4"
  ],
  "prHourlyLimit": 2,
  "prConcurrentLimit": 10,
  "minimumReleaseAge": "2 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "gradle": {
    "enabled": true
  },
  "docker": {
    "enabled": true
  },
  "dockerfile": {
    "enabled": true
  },
  "docker-compose": {
    "enabled": true
  },
  "packageRules": [
    {
      "matchPackageNames": [
        "com.google.guava:guava"
      ],
      "excludeVersions": "/-android$/"
    },
    {
      "matchPackageNames": [
        "software.amazon.awssdk:.*"
      ],
      "matchUpdateTypes": [
        "major",
        "minor"
      ]
    },
    {
      "matchPackageNames": [
        "com.h2database:h2"
      ],
      "enabled": false
    },
    {
      "matchManagers": [
        "dockerfile"
      ],
      "matchPaths": [
        ".*oidc-login-strapi.*"
      ],
      "matchPackagePatterns": [
        "^node$"
      ],
      "enabled": false
    },
    {
      "matchPaths": [
        ".*radius.*/build.gradle"
      ],
      "matchPackageNames": [
        "org.bouncycastle:bcprov-jdk15on"
      ],
      "enabled": false
    },
    {
      "description": "Ignore git-hash-looking versions for permit-sdk-java",
      "matchPackageNames": [
        "io.permit:permit-sdk-java"
      ],
      "allowedVersions": "!/^[0-9a-f]{7,40}$/"
    },
    {
      "description": "commons-codec 1.23 strict Base64 decoding breaks Shibboleth Base64Support (OpenSAML/pac4j); hold until Shibboleth supports it",
      "matchPackageNames": [
        "commons-codec:commons-codec"
      ],
      "allowedVersions": "<1.23.0"
    },
    {
      "description": "One pull request for the minor and patch updates of Gradle dependencies, so CI runs once for them",
      "matchManagers": [
        "gradle"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "Gradle minor and patch updates",
      "groupSlug": "gradle-non-major"
    },
    {
      "description": "One pull request for Docker image updates",
      "matchDatasources": [
        "docker"
      ],
      "groupName": "Docker images",
      "groupSlug": "docker-images"
    },
    {
      "description": "osixia/openldap 2.x is a different image with its own command line and layout; the CI OpenLDAP server is written for 1.x",
      "matchDatasources": [
        "docker"
      ],
      "matchPackageNames": [
        "osixia/openldap"
      ],
      "allowedVersions": "<2"
    },
    {
      "description": "One pull request for the minor and patch updates of npm packages",
      "matchManagers": [
        "npm"
      ],
      "matchUpdateTypes": [
        "minor",
        "patch"
      ],
      "groupName": "npm minor and patch updates",
      "groupSlug": "npm-non-major"
    },
    {
      "description": "One pull request for GitHub Actions updates",
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions"
    },
    {
      "description": "The AWS SDK releases almost daily; its updates come in a pull request of their own once a month",
      "matchPackageNames": [
        "/^software\\.amazon\\.awssdk:/"
      ],
      "groupName": "AWS SDK",
      "groupSlug": "aws-sdk",
      "schedule": [
        "* 0-5 1 * *"
      ]
    }
  ]
}
