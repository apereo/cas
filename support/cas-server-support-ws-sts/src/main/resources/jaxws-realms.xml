<?xml version="1.0" encoding="UTF-8"?>
<beans xmlns="http://www.springframework.org/schema/beans"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="http://www.springframework.org/schema/beans
        http://www.springframework.org/schema/beans/spring-beans.xsd">

    <import resource="classpath:META-INF/cxf/cxf.xml"/>

    <bean id="transportSTSRealmServiceName" class="javax.xml.namespace.QName">
        <constructor-arg value="http://docs.oasis-open.org/ws-sx/ws-trust/200512/"/>
        <constructor-arg value="SecurityTokenService"/>
        <constructor-arg value="ns1"/>
    </bean>
    <bean id="transportSTSRealmEndpointName" class="javax.xml.namespace.QName">
        <constructor-arg value="http://docs.oasis-open.org/ws-sx/ws-trust/200512/"/>
        <constructor-arg value="TransportUT_Port"/>
        <constructor-arg value="ns1"/>
    </bean>

    <bean id="transportSTSRealmAUT"
          class="org.apache.cxf.jaxws.spring.EndpointDefinitionParser$SpringEndpointImpl"
          init-method="publish" destroy-method="stop" lazy-init="false">
        <constructor-arg index="0" ref="cxf"/>
        <constructor-arg index="1" ref="transportSTSProviderBean"/>
        <property name="checkBlockConstruct" value="true"/>
        <property name="address" value="/CAS/STSServiceTransportUT"/>
        <property name="wsdlLocation" value="classpath:/wsdl/ws-trust-1.4-service.wsdl"/>
        <property name="serviceName" ref="transportSTSRealmServiceName"/>
        <property name="endpointName" ref="transportSTSRealmEndpointName"/>
        <property name="properties">
            <map>
                <entry key="ws-security.ut.validator" value-ref="transportUsernameTokenValidator"/>
            </map>
        </property>
    </bean>
</beans>
