{
  "dependencies": "saml-idp",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.authn.saml-idp.core.entity-id=https://cas.apereo.org/saml/idp",
    "--cas.authn.saml-idp.metadata.file-system.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/saml-md",
    "--cas.authn.saml-idp.core.attribute-query-profile-enabled=true",

    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=https://localhost:8443/cas",
    "--cas.server.scope=example.net",

    "--cas.authn.accept.name=STATIC",

    "--cas.authn.attribute-repository.stub.attributes.mail=casuser@example.org",
    "--cas.authn.attribute-repository.stub.attributes.sn=Apereo",
    "--cas.authn.attribute-repository.stub.attributes.givenName=CAS",
    "--cas.authn.attribute-repository.stub.attributes.eduPersonAffiliation=staff",

    "--cas.service-registry.core.init-from-json=true",
    "--cas.service-registry.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/services"
  ],
  "initScript": "${PWD}/ci/tests/httpbin/run-httpbin-server.sh"
}
