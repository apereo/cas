{
  "dependencies": "gauth,trusted-mfa,reports",
  "conditions": {
    "docker": "true"
  },
  "properties": [

    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=*",
    "--management.endpoints.access.default=UNRESTRICTED",
    
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.authn.mfa.gauth.core.trusted-device-enabled=true",
    "--cas.authn.mfa.gauth.crypto.enabled=false",
    "--cas.authn.mfa.gauth.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/accounts.json",

    "--cas.authn.mfa.trusted.device-fingerprint.cookie.enabled=false",
    "--cas.authn.mfa.trusted.device-fingerprint.client-ip.enabled=true",
    "--cas.authn.mfa.trusted.device-fingerprint.user-agent.enabled=true",
    "--cas.authn.mfa.trusted.device-fingerprint.browser.enabled=true",
    "--cas.authn.mfa.trusted.json.location=file:${TMPDIR}/${SCENARIO}-trusted-devices.json",
    "--cas.authn.mfa.trusted.cleaner.schedule.start-delay=PT5S",
    "--cas.authn.mfa.trusted.cleaner.schedule.repeat-interval=PT5S",

    "--cas.service-registry.core.init-from-json=true",
    "--cas.service-registry.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/services",

    "--spring.thymeleaf.cache=true",
    "--cas.view.template-prefixes=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/templates"
  ],
  "initScript": "${PWD}/ci/tests/httpbin/run-httpbin-server.sh"
}
