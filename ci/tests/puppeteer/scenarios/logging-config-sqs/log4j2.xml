<?xml version="1.0" encoding="UTF-8" ?>
<Configuration>
    <Appenders>
        <Console name="console" target="SYSTEM_OUT">
            <PatternLayout pattern="%highlight{%d %p [%c] - &lt;%m&gt;%n%throwable}"/>
        </Console>
        <SQSAppender name="sqs"
                     region="us-east-1"
                     credentialAccessKey="test"
                     credentialSecretKey="test"
                     endpoint="http://localhost:4566"
                     queueName="cas-logs"
                     queueTags="application->cas">
            <PatternLayout pattern="%p | %c | %m"/>
        </SQSAppender>
    </Appenders>
    <Loggers>
        <Logger name="org.apereo.cas" level="info"/>
        <Logger name="org.apereo.inspektr" level="info" additivity="false">
            <AppenderRef ref="console"/>
            <AppenderRef ref="sqs"/>
        </Logger>
        <Root level="warn">
            <AppenderRef ref="console"/>
        </Root>
    </Loggers>
</Configuration>
