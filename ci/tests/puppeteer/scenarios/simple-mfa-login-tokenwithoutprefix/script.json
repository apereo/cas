{
  "dependencies": "simple-mfa,trusted-mfa",
  "conditions": {
    "docker": "true"
  },

  "properties": [

    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.authn.attribute-repository.stub.attributes.phone=13477464523",
    "--cas.authn.attribute-repository.stub.attributes.mail=casuser@example.org",

    "--spring.mail.host=localhost",
    "--spring.mail.port=25000",

    "--cas.authn.mfa.simple.trusted-device-enabled=true",

    "--cas.authn.mfa.simple.mail.html=false",
    "--cas.authn.mfa.simple.mail.from=cas@example.com",
    "--cas.authn.mfa.simple.mail.subject=Token",
    "--cas.authn.mfa.simple.mail.text=${tokenWithoutPrefix}"
  ],
  "variations": [
    {
      "name": "default",
      "properties": []
    },
    {
      "name": "token-policy",
      "properties": [
        "--cas.authn.mfa.simple.token.core.time-to-kill-in-seconds=20",
        "--cas.authn.mfa.simple.token.core.token-type=ALPHANUMERIC",
        "--cas.authn.mfa.simple.token.core.token-length=10"
      ]
    },
    {
      "name": "rate-limited",
      "properties": [
        "--cas.authn.accept.users=casuser::Mellon,casuser2::Mellon,casuser3::Mellon",
        "--cas.authn.mfa.simple.bucket4j.enabled=true",
        "--cas.authn.mfa.simple.bucket4j.blocking=false",
        "--cas.authn.mfa.simple.bucket4j.bandwidth[0].capacity=2",
        "--cas.authn.mfa.simple.bucket4j.bandwidth[0].refill-count=2",
        "--cas.authn.mfa.simple.bucket4j.bandwidth[0].refill-duration=PT20S",
        "--cas.authn.mfa.simple.bucket4j.bandwidth[0].refill-strategy=INTERVALLY"
      ]
    }
  ],
  "initScript": "${PWD}/ci/tests/mail/run-mail-server.sh"
}
