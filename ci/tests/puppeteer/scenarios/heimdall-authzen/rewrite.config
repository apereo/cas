# AuthZEN locates PDP metadata by inserting the well-known segment between the host and the path of the
# policy decision point identifier. For https://localhost:8443/cas/heimdall a PEP asks for:
#
#   https://localhost:8443/.well-known/authzen-configuration/cas/heimdall
#
# That path is outside the /cas servlet context. This valve runs on the Tomcat engine, before a context is
# selected, and maps it onto /cas/heimdall/.well-known/authzen-configuration. The same rewrite belongs in
# whatever proxy fronts CAS.
RewriteRule ^/\.well-known/authzen-configuration(/.+)$ $1/.well-known/authzen-configuration [L]
