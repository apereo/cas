{
  "dependencies": "configuration-cloud-aws-ssm,configuration-cloud-aws-secretsmanager,configuration-cloud-aws-s3,reports",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.service-registry.core.init-from-json=true",

    "--management.endpoint.env.show-values=ALWAYS",
    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=env,refresh",
    "--management.endpoints.access.default=UNRESTRICTED",

    "--cas.spring.cloud.aws.ssm.endpoint=http://localhost:4566",
    "--cas.spring.cloud.aws.ssm.region=us-east-1",
    "--cas.spring.cloud.aws.ssm.credential-access-key=test",
    "--cas.spring.cloud.aws.ssm.credential-secret-key=test",

    "--cas.spring.cloud.aws.secrets-manager.endpoint=http://localhost:4566",
    "--cas.spring.cloud.aws.secrets-manager.region=us-east-1",
    "--cas.spring.cloud.aws.secrets-manager.credential-access-key=test",
    "--cas.spring.cloud.aws.secrets-manager.credential-secret-key=test",

    "--cas.spring.cloud.aws.s3.endpoint=http://localhost:4566",
    "--cas.spring.cloud.aws.s3.region=us-east-1",
    "--cas.spring.cloud.aws.s3.credential-access-key=test",
    "--cas.spring.cloud.aws.s3.credential-secret-key=test",
    "--cas.spring.cloud.aws.s3.bucket-name=cas-config"
  ],
  "initScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh"
}
