{
  "dependencies": "webauthn",
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.authn.mfa.web-authn.core.qr-code-authentication-enabled=false",
    "--cas.authn.mfa.web-authn.core.allowed-origins=https://localhost:8443",
    "--cas.authn.mfa.web-authn.core.application-id=https://localhost:8443",
    "--cas.authn.mfa.web-authn.core.relying-party-name=CAS WebAuthn Demo",
    "--cas.authn.mfa.web-authn.core.allow-primary-authentication=true",
    "--cas.authn.mfa.web-authn.core.user-verification-requirement=REQUIRED",
    "--cas.authn.mfa.web-authn.core.hints=security-key",
    "--cas.authn.mfa.web-authn.core.attestation-conveyance-preference=DIRECT"
  ],
  "variations": [
    {
      "name": "untrusted-attestation-allowed",
      "properties": [
        "--cas.authn.mfa.web-authn.core.allow-untrusted-attestation=true"
      ]
    },
    {
      "name": "untrusted-attestation-refused",
      "properties": [
        "--cas.authn.mfa.web-authn.core.allow-untrusted-attestation=false"
      ]
    }
  ]
}
