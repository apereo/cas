{
  "dependencies": "gauth,trusted-mfa-jdbc,trusted-mfa-redis,trusted-mfa-rest,trusted-mfa-dynamodb",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=*",
    "--management.endpoints.access.default=UNRESTRICTED",

    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.authn.mfa.gauth.core.trusted-device-enabled=true",
    "--cas.authn.mfa.gauth.crypto.enabled=false",
    "--cas.authn.mfa.gauth.json.location=file:${TMPDIR}/${SCENARIO}-accounts.json",

    "--cas.jdbc.show-sql=false"
  ],
  "variations": [
    {
      "name": "jdbc",
      "properties": [
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.redis.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.rest.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.dynamodb.enabled=false",
        "--cas.authn.mfa.trusted.jpa.properties.socketTimeout=2",
        "--cas.authn.mfa.trusted.jpa.connection-timeout=PT2S",
        "--cas.authn.mfa.trusted.jpa.leak-threshold=PT30S",
        "--cas.authn.mfa.trusted.jpa.ddl-auto=create-drop",
        "--cas.authn.mfa.trusted.jpa.user=postgres",
        "--cas.authn.mfa.trusted.jpa.password=password",
        "--cas.authn.mfa.trusted.jpa.driver-class=org.postgresql.Driver",
        "--cas.authn.mfa.trusted.jpa.url=jdbc:postgresql://localhost:5432/mfa",
        "--cas.authn.mfa.trusted.jpa.dialect=org.hibernate.dialect.PostgreSQLDialect"
      ]
    },
    {
      "name": "redis",
      "properties": [
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.jdbc.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.rest.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.dynamodb.enabled=false",
        "--cas.authn.mfa.trusted.redis.host=localhost",
        "--cas.authn.mfa.trusted.redis.port=6379",
        "--cas.authn.mfa.trusted.redis.timeout=PT2S"
      ]
    },
    {
      "name": "rest",
      "properties": [
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.jdbc.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.redis.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.dynamodb.enabled=false",
        "--cas.authn.mfa.trusted.rest.url=http://localhost:5612/trusted"
      ]
    },
    {
      "name": "dynamodb",
      "properties": [
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.jdbc.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.redis.enabled=false",
        "--CasFeatureModule.MultifactorAuthenticationTrustedDevices.rest.enabled=false",
        "--cas.authn.mfa.trusted.dynamo-db.endpoint=http://localhost:8000",
        "--cas.authn.mfa.trusted.dynamo-db.region=us-east-1",
        "--cas.authn.mfa.trusted.dynamo-db.credential-access-key=AKIAIPPIGGUNIO74C63Z",
        "--cas.authn.mfa.trusted.dynamo-db.credential-secret-key=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",
        "--cas.authn.mfa.trusted.dynamo-db.drop-tables-on-startup=true",
        "--cas.authn.mfa.trusted.dynamo-db.connection-timeout=PT1S",
        "--cas.authn.mfa.trusted.dynamo-db.socket-timeout=PT1S",
        "--cas.authn.mfa.trusted.dynamo-db.client-execution-timeout=PT1S"
      ]
    }
  ],
  "initScript": "${PWD}/ci/tests/postgres/run-postgres-server.sh,${PWD}/ci/tests/redis/run-redis-server.sh,${PWD}/ci/tests/dynamodb/run-dynamodb-server.sh,${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh"
}
