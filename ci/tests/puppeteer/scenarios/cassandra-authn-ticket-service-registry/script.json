{
  "dependencies": "cassandra-authentication,cassandra-ticket-registry,cassandra-service-registry,reports",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.prefix=${cas.server.name}/cas",
    "--cas.http-client.host-name-verifier=none",

    "--cas.authn.accept.enabled=false",
    "--cas.authn.cassandra.keyspace=cas",
    "--cas.authn.cassandra.local-dc=datacenter1",
    "--cas.authn.cassandra.ssl-protocols=TLSv1.2",
    "--cas.authn.cassandra.table-name=users_table",
    "--cas.authn.cassandra.username-attribute=user_attr",
    "--cas.authn.cassandra.password-attribute=pwd_attr",

    "--cas.ticket.registry.cassandra.keyspace=cas",
    "--cas.ticket.registry.cassandra.local-dc=datacenter1",
    "--cas.ticket.registry.cassandra.ssl-protocols=TLSv1.2",
    "--cas.ticket.registry.cassandra.crypto.encryption.key=7CITiW3O2dOpUYOwHJX3-w",
    "--cas.ticket.registry.cassandra.crypto.signing.key=CYPAXgmLzDnPjWEdCMeP360LorQjurUFtUgJGvBLdctpGgUDK1NjTnfjEmHJpnQHwQ52KYWpmQ4GlAmsxlDjiQ",
    "--cas.ticket.st.time-to-kill-in-seconds=30",

    "--cas.service-registry.core.init-from-json=false",
    "--cas.service-registry.schedule.start-delay=PT2S",
    "--cas.service-registry.schedule.repeat-interval=PT2S",
    "--cas.service-registry.cassandra.keyspace=cas",
    "--cas.service-registry.cassandra.local-dc=datacenter1",
    "--cas.service-registry.cassandra.ssl-protocols=TLSv1.2",

    "--cas.tgc.crypto.alg=A128CBC-HS256",
    "--cas.tgc.crypto.encryption.key=u696jJnPvm1DHLR7yVCSKMMzzoPoFxJZW4-MP1CkM5w",
    "--cas.tgc.crypto.signing.key=zPdNCd0R1oMR0ClzEqZzapkte8rO0tNvygYjmHoUhitAu6CBscwMC3ZTKy8tleTKiQ6GVcuiQQgxfd1nSKxf7w",
    "--cas.webflow.crypto.signing.key=Q4tQGAuJSmuJ5WA0zByB9P6hYr5dpTd2JJifyy6Tm_CJ35pkbdhFvcgG-3igDjA4CTjau6Z0yMft-dhVUbRnPQ",
    "--cas.webflow.crypto.encryption.key=g-Rk2ZvexS6tdooIiDh0IQ",

    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=*",
    "--management.endpoints.access.default=UNRESTRICTED"
  ],
  "bootstrapScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/bootstrap.sh",
  "instances": 2,
  "instance1": {
    "properties": [
      "--cas.server.name=https://localhost:8443",
      "--cas.host.name=cas-instance-8443"
    ]
  },
  "instance2": {
    "properties": [
      "--cas.server.name=https://localhost:8444",
      "--cas.host.name=cas-instance-8444"
    ]
  }
}
