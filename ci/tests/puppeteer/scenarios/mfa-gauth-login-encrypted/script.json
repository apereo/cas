{
  "dependencies": "gauth,gauth-jpa,gauth-redis,gauth-mongo,gauth-ldap,reports",
  "conditions": {
    "docker": "true"
  },
  "environmentVariables": [
    "CAS_LDAP_BIND_DN=cn=Directory Manager"
  ],
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",
    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=gauthCredentialRepository",
    "--management.endpoints.access.default=UNRESTRICTED",
    "--cas.authn.mfa.gauth.core.multiple-device-registration-enabled=true",
    "--cas.authn.mfa.gauth.core.maximum-authentication-attempts=3",
    "--cas.authn.mfa.gauth.id=GoogleAuth",
    "--cas.authn.mfa.gauth.crypto.enabled=true",
    "--cas.authn.mfa.gauth.crypto.signing.key=7zNPHGAiD-xPLt1EPJgbx9itrLg1zqnA6gI3YSWjwly6rVTSTwnM3h4DB4kt0rOCPZJGI1SmhVAxYw0G-lwJEw",
    "--cas.authn.mfa.gauth.crypto.encryption.key=RdiUkQaVzPiAQThap5mcBxSJRgV027Ckxl2hWY_3_OSFqsRFliM-b8H4tLOF9j_irsb7_uJy1l49fjdlocc2wg",
    "--logging.level.org.springframework.webflow=warn"
  ],
  "variations": [
    {
      "name": "jpa",
      "properties": [
        "--CasFeatureModule.GoogleAuthenticator.redis.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.mongo.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.ldap.enabled=false",
        "--cas.authn.mfa.gauth.jpa.ddl-auto=create",
        "--cas.authn.mfa.gauth.jpa.user=root",
        "--cas.authn.mfa.gauth.jpa.password=mypass",
        "--cas.authn.mfa.gauth.jpa.driver-class=org.mariadb.jdbc.Driver",
        "--cas.authn.mfa.gauth.jpa.url=jdbc:mariadb://localhost:3306/mysql?allowPublicKeyRetrieval=true&characterEncoding=UTF-8&useSSL=FALSE",
        "--cas.authn.mfa.gauth.jpa.dialect=org.hibernate.dialect.MariaDBDialect"
      ]
    },
    {
      "name": "redis",
      "properties": [
        "--CasFeatureModule.GoogleAuthenticator.jpa.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.mongo.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.ldap.enabled=false",
        "--cas.authn.mfa.gauth.redis.host=localhost",
        "--cas.authn.mfa.gauth.redis.port=6379"
      ]
    },
    {
      "name": "mongo",
      "properties": [
        "--CasFeatureModule.GoogleAuthenticator.jpa.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.redis.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.ldap.enabled=false",
        "--cas.authn.mfa.gauth.mongo.host=localhost",
        "--cas.authn.mfa.gauth.mongo.port=27017",
        "--cas.authn.mfa.gauth.mongo.user-id=root",
        "--cas.authn.mfa.gauth.mongo.password=secret",
        "--cas.authn.mfa.gauth.mongo.authentication-database-name=admin",
        "--cas.authn.mfa.gauth.mongo.database-name=gauth",
        "--cas.authn.mfa.gauth.mongo.drop-collection=true"
      ]
    },
    {
      "name": "ldap",
      "properties": [
        "--CasFeatureModule.GoogleAuthenticator.jpa.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.redis.enabled=false",
        "--CasFeatureModule.GoogleAuthenticator.mongo.enabled=false",
        "--cas.authn.mfa.gauth.ldap.ldap-url=ldap://localhost:10389",
        "--cas.authn.mfa.gauth.ldap.base-dn=ou=gauth,dc=example,dc=org",
        "--cas.authn.mfa.gauth.ldap.search-filter=cn={0}",
        "--cas.authn.mfa.gauth.ldap.account-attribute-name=description",
        "--cas.authn.mfa.gauth.ldap.bind-dn=${CAS_LDAP_BIND_DN}",
        "--cas.authn.mfa.gauth.ldap.bind-credential=password"
      ]
    }
  ],
  "initScript": "${PWD}/ci/tests/mariadb/run-mariadb-server.sh,${PWD}/ci/tests/redis/run-redis-server.sh,${PWD}/ci/tests/mongodb/run-mongodb-server.sh,${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh"
}
