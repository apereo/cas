{
  "dependencies": "stateless-ticket-registry,saml-idp,oidc,pac4j-webflow,pac4j-saml,interrupt-webflow,simple-mfa,reports",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",
    "--cas.server.scope=example.net",

    "--cas.http-client.host-name-verifier=none",

    "--cas.authn.accept.users=casuser::Mellon,casblock::Mellon,loaduser0::Mellon,loaduser1::Mellon,loaduser2::Mellon,loaduser3::Mellon,loaduser4::Mellon,loaduser5::Mellon,loaduser6::Mellon,loaduser7::Mellon,loaduser8::Mellon,loaduser9::Mellon",

    "--cas.authn.attribute-repository.stub.attributes.organization=apereo",
    "--cas.authn.attribute-repository.json[0].location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/attribute-repository.json",
    "--cas.authn.attribute-repository.json[0].id=MyJson",

    "--cas.ticket.st.time-to-kill-in-seconds=20",

    "--spring.mail.host=localhost",
    "--spring.mail.port=25000",
    "--cas.authn.attribute-repository.stub.attributes.mail=casuser@example.org",
    "--cas.authn.mfa.simple.token.core.time-to-kill-in-seconds=60",
    "--cas.authn.mfa.simple.mail.html=false",
    "--cas.authn.mfa.simple.mail.from=cas@example.com",
    "--cas.authn.mfa.simple.mail.subject=Token",
    "--cas.authn.mfa.simple.mail.text=${token}",

    "--cas.tgc.crypto.alg=A128CBC-HS256",
    "--cas.tgc.crypto.encryption.key=u696jJnPvm1DHLR7yVCSKMMzzoPoFxJZW4-MP1CkM5w",
    "--cas.tgc.crypto.signing-enabled=false",

    "--cas.webflow.crypto.signing.key=v43dwqO_GbGSVsFqgPFpVdwdMSEunMUzc4QSF13x18kInHPeRuvntleljO5Y5cKqDGAFe1vv10mM4tpyoKyBBA",
    "--cas.webflow.crypto.encryption.key=2PikjfOKY6n8Bbux2cy-Hg",

    "--cas.interrupt.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/accounts.json",

    "--cas.authn.saml-idp.core.entity-id=https://cas.apereo.org/saml/idp",
    "--cas.authn.saml-idp.core.session-storage-type=BROWSER_STORAGE",
    "--cas.authn.saml-idp.metadata.file-system.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/saml-md",
    "--cas.authn.saml-idp.metadata.http.force-metadata-refresh=false",

    "--cas.authn.oidc.core.issuer=${cas.server.prefix}/oidc",
    "--cas.authn.oidc.jwks.file-system.jwks-file=file:${#systemProperties['java.io.tmpdir']}/keystore.jwks",
    "--cas.authn.oauth.session-replication.replicate-sessions=true",
    "--cas.authn.oauth.session-replication.cookie.crypto.enabled=true",
    "--cas.authn.oauth.core.user-profile-view-type=FLAT",

    "--cas.authn.pac4j.core.session-replication.replicate-sessions=true",
    "--cas.authn.pac4j.core.session-replication.cookie.crypto.enabled=true",

    "--cas.authn.pac4j.saml[0].keystore-password=pac4j-demo-passwd",
    "--cas.authn.pac4j.saml[0].private-key-password=pac4j-demo-passwd",
    "--cas.authn.pac4j.saml[0].service-provider-entity-id=cas:apereo:pac4j:saml",
    "--cas.authn.pac4j.saml[0].metadata.service-provider.file-system.location=${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/saml-md/sp-metadata.xml",
    "--cas.authn.pac4j.saml[0].keystore-path=${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/saml-md/samlKeystore.jks",
    "--cas.authn.pac4j.saml[0].metadata.identity-provider-metadata-path=http://localhost:9443/simplesaml/saml2/idp/metadata.php",
    "--cas.authn.pac4j.saml[0].destination-binding=urn:oasis:names:tc:SAML:2.0:bindings:HTTP-Redirect",
    "--cas.authn.pac4j.saml[0].client-name=SAML2Client",

    "--cas.service-registry.core.init-from-json=true",
    "--cas.service-registry.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/services",

    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=health",
    "--management.endpoint.health.show-details=always",
    "--management.endpoints.access.default=UNRESTRICTED"
  ],
  "initScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh",
  "readyScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/ready.sh"
}
