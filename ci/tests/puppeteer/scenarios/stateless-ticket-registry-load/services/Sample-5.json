{
  "@class" : "org.apereo.cas.services.CasRegisteredService",
  "serviceId" : "^https://localhost:9859/anything/proxy.*",
  "name" : "Proxy",
  "id" : 5,
  "evaluationOrder" : 5,
  "proxyPolicy" : {
    "@class" : "org.apereo.cas.services.RegexMatchingRegisteredServiceProxyPolicy",
    "pattern" : "^https?://.*"
  },
  "attributeReleasePolicy" : {
    "@class" : "org.apereo.cas.services.ReturnAllowedAttributeReleasePolicy",
    "authorizedToReleaseProxyGrantingTicket" : true,
    "allowedAttributes" : [ "java.util.ArrayList", [ "organization" ] ]
  },
  "publicKey" : {
    "@class" : "org.apereo.cas.services.RegisteredServicePublicKeyImpl",
    "location" : "file://${#environmentVariables['PWD']}/ci/tests/puppeteer/scenarios/${#environmentVariables['SCENARIO']}/public.key",
    "algorithm" : "RSA"
  }
}
