{
  "dependencies": "core",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.http-web-request.header.xss=false",

    "--cas.http-web-request.pattern-to-block=javascript(:|%3A)",
    "--cas.http-web-request.characters-to-forbid=<",
    "--cas.http-web-request.only-post-params=username,password",
    "--cas.http-web-request.allow-multi-value-parameters=false",
    "--cas.http-web-request.params-to-check=ticket,service,renew,gateway,locale",

    "--cas.service-registry.core.init-from-json=true",
    "--cas.service-registry.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/services"
  ],
  "initScript": "${PWD}/ci/tests/httpbin/run-httpbin-server.sh"
}
