{
  "dependencies": "reports,palantir,saml-idp,saml-idp-metadata-mongo",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.service-registry.core.init-from-json=true",
    "--cas.service-registry.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/services",

    "--spring.security.user.name=casadmin",
    "--spring.security.user.password=password",
    "--spring.security.user.roles=ADMIN",

    "--cas.http-web-request.header.content-security-policy=",

    "--cas.authn.saml-idp.core.entity-id=https://cas.apereo.org/saml/idp",
    "--cas.authn.saml-idp.metadata.file-system.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/saml-md",

    "--CasFeatureModule.SAMLIdentityProviderMetadata.mongo.enabled=false",
    "--cas.authn.saml-idp.metadata.mongo.database-name=saml-metadata",
    "--cas.authn.saml-idp.metadata.mongo.drop-collection=true",
    "--cas.authn.saml-idp.metadata.mongo.collection=saml-sp-metadata",
    "--cas.authn.saml-idp.metadata.mongo.host=localhost",
    "--cas.authn.saml-idp.metadata.mongo.port=27017",
    "--cas.authn.saml-idp.metadata.mongo.user-id=root",
    "--cas.authn.saml-idp.metadata.mongo.password=secret",
    "--cas.authn.saml-idp.metadata.mongo.authentication-database-name=admin",

    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=*",
    "--management.endpoints.access.default=UNRESTRICTED"
  ],
  "initScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh"
}
