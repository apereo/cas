{
  "dependencies": "session-hazelcast,webauthn,webauthn-jpa,webauthn-mongo,webauthn-redis,webauthn-rest,webauthn-dynamodb",
  "conditions": {
    "docker": "true"
  },
  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=${cas.server.name}/cas",

    "--cas.authn.mfa.web-authn.core.allow-untrusted-attestation=true",
    "--cas.authn.mfa.web-authn.core.qr-code-authentication-enabled=false",
    "--cas.authn.mfa.web-authn.core.allowed-origins=https://localhost:8443",
    "--cas.authn.mfa.web-authn.core.application-id=https://localhost:8443",
    "--cas.authn.mfa.web-authn.core.relying-party-name=CAS WebAuthn Demo",
    "--cas.authn.mfa.web-authn.core.allow-primary-authentication=false",
    "--cas.authn.mfa.web-authn.crypto.enabled=false",

    "--cas.monitor.endpoints.endpoint.defaults.access=ANONYMOUS",
    "--management.endpoints.web.exposure.include=webAuthnDevices",
    "--management.endpoints.access.default=UNRESTRICTED"
  ],
  "variations": [
    {
      "name": "jpa",
      "properties": [
        "--CasFeatureModule.WebAuthn.mongo.enabled=false",
        "--CasFeatureModule.WebAuthn.redis.enabled=false",
        "--CasFeatureModule.WebAuthn.rest.enabled=false",
        "--CasFeatureModule.WebAuthn.dynamodb.enabled=false",
        "--cas.authn.mfa.web-authn.jpa.ddl-auto=create",
        "--cas.authn.mfa.web-authn.jpa.user=root",
        "--cas.authn.mfa.web-authn.jpa.password=mypass",
        "--cas.authn.mfa.web-authn.jpa.driver-class=org.mariadb.jdbc.Driver",
        "--cas.authn.mfa.web-authn.jpa.url=jdbc:mariadb://localhost:3306/mysql?allowPublicKeyRetrieval=true&characterEncoding=UTF-8&useSSL=FALSE",
        "--cas.authn.mfa.web-authn.jpa.dialect=org.hibernate.dialect.MariaDBDialect"
      ]
    },
    {
      "name": "mongo",
      "properties": [
        "--CasFeatureModule.WebAuthn.jpa.enabled=false",
        "--CasFeatureModule.WebAuthn.redis.enabled=false",
        "--CasFeatureModule.WebAuthn.rest.enabled=false",
        "--CasFeatureModule.WebAuthn.dynamodb.enabled=false",
        "--cas.authn.mfa.web-authn.mongo.host=localhost",
        "--cas.authn.mfa.web-authn.mongo.port=27017",
        "--cas.authn.mfa.web-authn.mongo.user-id=root",
        "--cas.authn.mfa.web-authn.mongo.password=secret",
        "--cas.authn.mfa.web-authn.mongo.authentication-database-name=admin",
        "--cas.authn.mfa.web-authn.mongo.database-name=webauthn",
        "--cas.authn.mfa.web-authn.mongo.drop-collection=true"
      ]
    },
    {
      "name": "redis",
      "properties": [
        "--CasFeatureModule.WebAuthn.jpa.enabled=false",
        "--CasFeatureModule.WebAuthn.mongo.enabled=false",
        "--CasFeatureModule.WebAuthn.rest.enabled=false",
        "--CasFeatureModule.WebAuthn.dynamodb.enabled=false",
        "--cas.authn.mfa.web-authn.redis.host=localhost",
        "--cas.authn.mfa.web-authn.redis.port=6379"
      ]
    },
    {
      "name": "rest",
      "properties": [
        "--CasFeatureModule.WebAuthn.jpa.enabled=false",
        "--CasFeatureModule.WebAuthn.mongo.enabled=false",
        "--CasFeatureModule.WebAuthn.redis.enabled=false",
        "--CasFeatureModule.WebAuthn.dynamodb.enabled=false",
        "--cas.authn.mfa.web-authn.rest.url=http://localhost:5613/webauthn"
      ]
    },
    {
      "name": "dynamodb",
      "properties": [
        "--CasFeatureModule.WebAuthn.jpa.enabled=false",
        "--CasFeatureModule.WebAuthn.mongo.enabled=false",
        "--CasFeatureModule.WebAuthn.redis.enabled=false",
        "--CasFeatureModule.WebAuthn.rest.enabled=false",
        "--cas.authn.mfa.web-authn.dynamo-db.endpoint=http://localhost:8000",
        "--cas.authn.mfa.web-authn.dynamo-db.region=us-east-1",
        "--cas.authn.mfa.web-authn.dynamo-db.credential-access-key=AKIAIPPIGGUNIO74C63Z",
        "--cas.authn.mfa.web-authn.dynamo-db.credential-secret-key=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",
        "--cas.authn.mfa.web-authn.dynamo-db.drop-tables-on-startup=true"
      ]
    }
  ],
  "initScript": "${PWD}/ci/tests/mariadb/run-mariadb-server.sh,${PWD}/ci/tests/mongodb/run-mongodb-server.sh,${PWD}/ci/tests/redis/run-redis-server.sh,${PWD}/ci/tests/dynamodb/run-dynamodb-server.sh"
}
