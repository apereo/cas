{
  "dependencies": "passwordless-webflow,passwordless-jpa,passwordless-mongo",
  "conditions": {
    "docker": "true"
  },

  "properties": [
    "--cas.server.name=https://localhost:8443",
    "--cas.server.prefix=https://localhost:8443/cas",

    "--cas.service-registry.core.init-from-json=true",

    "--spring.mail.host=localhost",
    "--spring.mail.port=25000",

    "--cas.authn.passwordless.tokens.mail.html=false",
    "--cas.authn.passwordless.tokens.mail.text=${token}",
    "--cas.authn.passwordless.tokens.mail.from=casuser@apereo.org",
    "--cas.authn.passwordless.tokens.mail.subject=Passwordless AuthN"
  ],
  "variations": [
    {
      "name": "jpa",
      "properties": [
        "--CasFeatureModule.PasswordlessAuthn.mongo.enabled=false",
        "--cas.authn.passwordless.tokens.jpa.user=root",
        "--cas.authn.passwordless.tokens.jpa.password=password",
        "--cas.authn.passwordless.tokens.jpa.driver-class=com.mysql.cj.jdbc.Driver",
        "--cas.authn.passwordless.tokens.jpa.url=jdbc:mysql://localhost:3306/cas?allowPublicKeyRetrieval=true&characterEncoding=UTF-8&useSSL=FALSE",
        "--cas.authn.passwordless.tokens.jpa.dialect=org.hibernate.dialect.MySQLDialect",
        "--cas.authn.passwordless.tokens.jpa.ddl-auto=create-drop",
        "--cas.authn.passwordless.accounts.json.location=file:${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/accounts.json"
      ]
    },
    {
      "name": "mongo",
      "properties": [
        "--CasFeatureModule.PasswordlessAuthn.jpa.enabled=false",
        "--cas.authn.passwordless.tokens.mongo.host=localhost",
        "--cas.authn.passwordless.tokens.mongo.port=27017",
        "--cas.authn.passwordless.tokens.mongo.user-id=root",
        "--cas.authn.passwordless.tokens.mongo.password=secret",
        "--cas.authn.passwordless.tokens.mongo.authentication-database-name=admin",
        "--cas.authn.passwordless.tokens.mongo.database-name=passwordless",
        "--cas.authn.passwordless.tokens.mongo.collection=PasswordlessTokens",
        "--cas.authn.passwordless.tokens.mongo.drop-collection=true",
        "--cas.authn.passwordless.accounts.mongo.host=localhost",
        "--cas.authn.passwordless.accounts.mongo.port=27017",
        "--cas.authn.passwordless.accounts.mongo.user-id=root",
        "--cas.authn.passwordless.accounts.mongo.password=secret",
        "--cas.authn.passwordless.accounts.mongo.authentication-database-name=admin",
        "--cas.authn.passwordless.accounts.mongo.database-name=passwordless",
        "--cas.authn.passwordless.accounts.mongo.collection=PasswordlessAccounts"
      ]
    }
  ],
  "initScript": "${PWD}/ci/tests/puppeteer/scenarios/${SCENARIO}/init.sh"
}
